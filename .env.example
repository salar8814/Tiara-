# Path to the SQLite database file (created and seeded automatically on first run)
DATABASE_PATH=./data/tiara.db

# Payment: "disabled" (default in production), "sandbox" (default in development; clearly labelled test payments)
# A real provider (e.g. a Shaparak PSP) must be added in src/lib/integrations/index.ts and src/lib/repo/orders.ts before going live.
PAYMENT_MODE=sandbox

# OTP delivery: "display" shows the code on screen (development only), "disabled" blocks login.
# A real SMS provider must be wired into requestOtpAction (src/app/actions/auth.ts).
OTP_MODE=display

# Payroll deduction requires an HR/finance integration. Keep "false" until it exists.
PAYROLL_INTEGRATION=false

# HMAC secret for guest RFQ access cookies (auto-generated and stored in the DB if unset)
# SESSION_SECRET=
