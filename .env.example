# ── Environment ──────────────────────────────────────────────────────────────
# development | test | staging | production. Unset → derived from NODE_ENV
# (`next start` ⇒ production). In production every demo feature is refused and
# the server will not start with OTP_MODE=display, PAYMENT_MODE=sandbox or
# without SESSION_SECRET (src/lib/startup-check.ts).
TIARA_ENV=development

# HMAC secret for signed cookies, ≥ 32 characters. REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# SQLite file (created, migrated and seeded on first start). One app process per file — see docs/ARCHITECTURE_DECISIONS.md.
DATABASE_PATH=./data/tiara.db

# Set to true ONLY behind a reverse proxy that overwrites X-Forwarded-For.
# Without it, per-IP rate limits fall back to one shared bucket (per-mobile/per-phone limits still apply).
TRUST_PROXY=false

# ── Demo modes (refused when TIARA_ENV=production) ──────────────────────────
# OTP_MODE: display = show the login code on screen (no SMS provider) | disabled
OTP_MODE=display
# PAYMENT_MODE: sandbox = simulated gateway, orders marked paid_sandbox | disabled
PAYMENT_MODE=sandbox

# Payroll deduction requires an HR/finance integration that does not exist yet. Keep false.
PAYROLL_INTEGRATION=false
